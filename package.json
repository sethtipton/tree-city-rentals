{
  "name": "tree-city-rentals",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images:build": "node scripts/generate-public-images.mjs",
    "prebuild": "npm run images:build",
    "build": "vite build",
    "postbuild": "vite build --ssr src/prerender.jsx --outDir node_modules/.cache/tree-city-prerender --emptyOutDir && node scripts/create-pages-fallbacks.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:db": "node scripts/test-maintenance-db.mjs --local",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "lucide-react": "^1.28.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "jsdom": "^30.1.0",
    "oxlint": "^1.75.0",
    "sharp": "^0.35.5",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
